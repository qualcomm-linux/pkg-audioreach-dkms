# Qualcomm AudioReach runtime permissions.
#
# Subsystems such as PipeWire run in group "audio" and need access to
# corresponding device nodes in order to initialize AudioReach GSL.

KERNEL=="msm_audio_mem", GROUP="audio", MODE="0660"
KERNEL=="aud_pasthru_adsp", GROUP="audio", MODE="0660"
SUBSYSTEM=="dma_heap", KERNEL=="system", OWNER="root", GROUP="audio", MODE="0660"
